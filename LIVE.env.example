# Live / production environment checklist
# Copy values into your host (Vercel / Render / Railway) — never commit real secrets.

## Frontend (Vercel)
NEXT_PUBLIC_API_URL=https://YOUR_API_DOMAIN
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

## Backend (Render / Railway / VPS)
NODE_ENV=production
PORT=5000
USE_MEMORY_DB=false
MONGODB_URI=mongodb+srv://...
JWT_SECRET=long_random_secret
CLIENT_URL=https://YOUR_FRONTEND_DOMAIN
ALLOWED_ORIGINS=https://YOUR_FRONTEND_DOMAIN
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=strong_password

## Stripe Dashboard (Live mode)
# Webhook URL: https://YOUR_API_DOMAIN/api/webhooks/stripe
# Event: checkout.session.completed
