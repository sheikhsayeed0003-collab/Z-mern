# Live / production environment checklist
# Copy into Vercel Project Settings → Environment Variables — never commit real secrets.

## Vercel (one project, frontend + backend services)
# Framework Preset: Services
# Do NOT set NEXT_PUBLIC_API_URL (same-origin /api → backend via vercel.json)

NODE_ENV=production
USE_MEMORY_DB=false
MONGODB_URI=mongodb+srv://...
JWT_SECRET=long_random_secret
CLIENT_URL=https://YOUR_VERCEL_DOMAIN
ALLOWED_ORIGINS=https://YOUR_VERCEL_DOMAIN
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=strong_password

## Stripe Dashboard (Live mode)
# Webhook URL: https://YOUR_VERCEL_DOMAIN/api/webhooks/stripe
# Event: checkout.session.completed
